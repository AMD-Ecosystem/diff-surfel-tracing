 using namespace hiprt;
 
+// On Windows, LoadLibraryA with a bare DLL name uses the legacy DLL search
+// order (System32 before PATH entries) so "amdhip64_7.dll" from the AMD
+// display driver wins over the ROCm SDK's copy.  Build full-path lists from
+// ROCM_PATH / HIP_PATH so the ROCm SDK DLLs are loaded instead.
+struct DllPathList {
+    std::vector<std::string> strs;
+    std::vector<const char*> ptrs;
+
+    void build( const char** bare, const char* rocm_dir ) {
+        strs.clear(); ptrs.clear();
+        if ( rocm_dir ) {
+            for ( const char** p = bare; *p; ++p )
+                strs.push_back( std::string( rocm_dir ) + "\\bin\\" + *p );
+        }
+        for ( const char** p = bare; *p; ++p )
+            strs.push_back( *p );
+        for ( auto& s : strs ) ptrs.push_back( s.c_str() );
+        ptrs.push_back( nullptr );
+    }
+    const char** data() { return ptrs.data(); }
+};
+
 hiprtError hiprtCreateContext( uint32_t hiprtApiVersion, const hiprtContextCreationInput& input, hiprtContext& contextOut )
 {
+    DllPathList hip_paths, hiprtc_paths;
+#ifdef _WIN32
+    const char* rocm = getenv( "ROCM_PATH" );
+    if ( !rocm ) rocm = getenv( "HIP_PATH" );
+    hip_paths.build( g_hip_paths, rocm );
+    hiprtc_paths.build( g_hiprtc_paths, rocm );
+    oroInitialize( ( input.deviceType == hiprtDeviceAMD ) ? ORO_API_HIP : ORO_API_CUDA, 0, hip_paths.data(), hiprtc_paths.data() );
+#else
 	oroInitialize( ( input.deviceType == hiprtDeviceAMD ) ? ORO_API_HIP : ORO_API_CUDA, 0, g_hip_paths, g_hiprtc_paths );
+#endif
 	if ( hiprtApiVersion != HIPRT_API_VERSION ) return hiprtErrorInvalidApiVersion;
 
